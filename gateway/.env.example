# Export these variables in the gateway process environment. No .env auto-loading.
DRUNIX_MSP_ID=Org1MSP
DRUNIX_CERT_PATH=/absolute/path/to/existing/User1/signing-certificate.pem
DRUNIX_KEY_PATH=/absolute/path/to/existing/User1/signing-key
DRUNIX_TLS_CA_PATH=/absolute/path/to/existing/peer/tls/ca.crt
DRUNIX_PEER_ENDPOINT=dns:///localhost:7051
DRUNIX_TLS_SERVER_NAME=peer0.org1.example.com
DRUNIX_CHANNEL=mychannel
DRUNIX_CHAINCODE=basic
DRUNIX_LISTEN_ADDRESS=127.0.0.1:8001
DRUNIX_EVALUATE_TIMEOUT=5s
