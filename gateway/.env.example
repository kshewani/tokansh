# Export these variables in the gateway process environment. No .env auto-loading.
DRUNIX_MSP_ID=Org1MSP
DRUNIX_CERT_PATH=/absolute/path/to/existing/User1/signing-certificate.pem
DRUNIX_KEY_PATH=/absolute/path/to/existing/User1/signing-key
DRUNIX_TLS_CA_PATH=/absolute/path/to/existing/peer/tls/ca.crt
DRUNIX_PEER_ENDPOINT=dns:///127.0.0.1:7051
DRUNIX_TLS_SERVER_NAME=peer0.org1.example.com
DRUNIX_CHANNEL=mychannel
DRUNIX_CHAINCODE=basic
DRUNIX_LISTEN_ADDRESS=127.0.0.1:8001
DRUNIX_EVALUATE_TIMEOUT=5s
# Read-only verifier CLI peers: channel checks use CP; basic queries use LP.
DRUNIX_CLI_COMMITTING_PEER_ADDRESS=localhost:7061
DRUNIX_CLI_LITE_PEER_ADDRESS=localhost:7051
# Optional authenticated TokANSH integration. Each secret must be distinct,
# independently generated random 32 bytes encoded as 64 hex characters.
# Missing secrets disable all TokANSH endpoints; basic diagnostics stay available.
# TOKANSH_GATEWAY_SECRET=
# TOKANSH_OPERATOR_SECRET=
