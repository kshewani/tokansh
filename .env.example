# TokANSH application configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# TokANSH application database (not DRUNIX internal YugabyteDB)
DATABASE_URL=sqlite:///./data/tokansh.db

# Frontend origins permitted by the backend (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for more origins, e.g. Vercel preview deployments
CORS_ORIGIN_REGEX=

# Private TokANSH Go gateway (gateway/, see docs/GATEWAY_ADAPTER_CONTRACT.md). Loopback only,
# e.g. http://127.0.0.1:8001. Empty = not configured: every ledger operation fails safely
# with LEDGER_UNAVAILABLE. There is no simulator mode.
DRUNIX_GATEWAY_URL=
# Two distinct random 32-byte secrets (64 hex characters), identical in the gateway process.
# Never commit real values; never expose them to the frontend.
TOKANSH_GATEWAY_SECRET=
TOKANSH_OPERATOR_SECRET=
# Optional signer pin "Org1MSP:<sha256 of signer certificate>"
DRUNIX_SIGNER=
DRUNIX_CHANNEL=mychannel
TOKANSH_CHAINCODE=tokansh
DRUNIX_GATEWAY_TIMEOUT_SECONDS=7
DRUNIX_COMMIT_POLL_ATTEMPTS=3
DRUNIX_COMMIT_POLL_INTERVAL_SECONDS=1

# Demonstration loan-to-value threshold in basis points (6000 = 60%)
MAX_LTV_BPS=6000
