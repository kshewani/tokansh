# TokANSH application configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# TokANSH application database (not DRUNIX internal YugabyteDB)
DATABASE_URL=sqlite:///./data/tokansh.db

# Frontend origins permitted by the backend (comma-separated)
CORS_ORIGINS=http://localhost:5173
# Optional regex for more origins, e.g. Vercel preview deployments
CORS_ORIGIN_REGEX=

# Go DRUNIX gateway adapter (private TokANSH interface, see docs/GATEWAY_ADAPTER_CONTRACT.md).
# Empty = not configured: every ledger operation fails safely with LEDGER_UNAVAILABLE.
# There is no simulator mode.
DRUNIX_GATEWAY_URL=
DRUNIX_CHANNEL=mychannel
DRUNIX_CHAINCODE=tokansh
DRUNIX_TIMEOUT_SECONDS=30
DRUNIX_COMMIT_POLL_ATTEMPTS=3
DRUNIX_COMMIT_POLL_INTERVAL_SECONDS=1

# Demonstration loan-to-value threshold in basis points (6000 = 60%)
MAX_LTV_BPS=6000
