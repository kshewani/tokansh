# TokANSH application configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# TokANSH application database (not DRUNIX internal YugabyteDB)
DATABASE_URL=sqlite:///./data/tokansh.db

# Frontend origins permitted by the backend
CORS_ORIGINS=http://localhost:5173

# Frontend API configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

# DRUNIX gateway configuration will be added after validating
# the actual self-hosted network and gateway implementation.
