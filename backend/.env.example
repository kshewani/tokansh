APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/tokansh.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local demo convenience only. Production authentication is outside M2.
DEMO_AUTH_ENABLED=true
# Optional M3.2 private gateway. Unset means explicitly unavailable, with no fallback.
# DRUNIX_GATEWAY_URL=http://127.0.0.1:8001
DRUNIX_GATEWAY_TIMEOUT_SECONDS=7
# Private registration operator integration only; never expose to Vite/React.
# Distinct random 32-byte secrets encoded as 64 hex characters, shared with gateway.
# TOKANSH_GATEWAY_SECRET=
# TOKANSH_OPERATOR_SECRET=
